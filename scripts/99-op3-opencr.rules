# Port serial OP3 -> nama tetap /dev/ttyOP3 dan /dev/ttyOPENCR
#
# Pasang di HOST (bukan di dalam container):
#   sudo cp scripts/99-op3-opencr.rules /etc/udev/rules.d/99-op3-opencr.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# DUA jalur, tidak lagi satu. Firmware "opencr_op3 edited by Fayyadh Raja Gula"
# memindahkan DXL_PORT dari Serial3 ke Serial (dxl_def.h), jadi sub controller
# ID 200 -- IMU, magnetometer, tombol, buzzer, daya DXL -- menjawab di micro-USB
# OpenCR, bukan lagi di bus TTL bersama servo:
#
#   ttyOP3    = U2D2  -> 20 servo saja
#   ttyOPENCR = OpenCR -> ID 200 saja
#
# Keduanya wajib punya nama tetap: /dev/ttyACM0 bisa berpindah ke ttyACM1 begitu
# ada perangkat CDC lain tercolok atau OpenCR di-reset, dan OP3.robot menyebut
# nama port secara harfiah.

# U2D2 (FT232H) di bus DXL -- 20 servo
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", SYMLINK+="ttyOP3", MODE="0666"


# OpenCR CDC -- sub controller ID 200 (IMU + magnetometer). Tetap world-writable
# supaya bisa dipakai flashing dan serial monitor tanpa sudo.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="ttyOPENCR", MODE="0666"
