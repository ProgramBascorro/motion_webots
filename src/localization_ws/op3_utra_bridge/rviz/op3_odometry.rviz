Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
  - Class: rviz_common/Time
    Name: Time

Visualization Manager:
  Class: ""
  Displays:
    # Grid (ground plane)
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Color: 160; 160; 164
      Cell Size: 0.5
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: odom
      Value: true
      
    # Robot Model (from URDF)
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1.0
      Value: true
      
    # TF (coordinate frames)
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.3
      Frame Timeout: 15.0
      Frames:
        All Enabled: true
      Value: true
      
    # Odometry (current pose with uncertainty)
    - Class: rviz_default_plugins/Odometry
      Name: Odometry
      Enabled: true
      Topic:
        Value: /odom_combined
        Reliability Policy: Reliable
      Shape:
        Type: Arrow
        Color: 255; 128; 0  # Orange
        Alpha: 1.0
        Shaft Length: 0.5
        Shaft Diameter: 0.05
        Head Length: 0.15
        Head Diameter: 0.1
      Covariance:
        Position:
          Enabled: true
          Color: 204; 51; 204  # Purple
          Alpha: 0.3
          Scale: 3.0
        Orientation:
          Enabled: true
          Color: 255; 255; 127
          Alpha: 0.5
          Scale: 0.3
      Keep: 1
      Value: true
      
    # Path (trajectory trail)
    - Class: rviz_default_plugins/Path
      Name: Odometry Path
      Enabled: true
      Topic:
        Value: /odom_path
        Reliability Policy: Reliable
      Color: 0; 255; 0  # Green
      Alpha: 1.0
      Buffer Length: 500
      Line Style: Lines
      Line Width: 0.02
      Pose Style: None
      Value: true
      
    # Axes at robot base
    - Class: rviz_default_plugins/Axes
      Name: Robot Axes
      Enabled: true
      Reference Frame: base_link
      Length: 0.3
      Radius: 0.02
      Value: true
      
    # Camera Image (optional)
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: false
      Topic:
        Value: /robotis_op3/camera/image_raw
        Reliability Policy: Reliable
      Normalize Range: true
      Value: false
      
    # IMU (optional)
    - Class: rviz_imu_plugin/Imu
      Name: IMU
      Enabled: false
      Topic:
        Value: /imu/data
        Reliability Policy: Reliable
      Acceleration properties:
        Enable acceleration: true
        Acc. vector color: 192; 97; 203
        Acc. vector scale: 1.0
        Acc. vector alpha: 0.2
      Axes properties:
        Enable axes: false
      Value: false

  # Global Options
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30

  # Views Configuration
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Orbit View
      Distance: 3.0
      Enable Stereo Rendering:
        Value: false
      Focal Point:
        X: 0.0
        Y: 0.0
        Z: 0.0
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Near Clip Distance: 0.01
      Pitch: 0.5
      Target Frame: base_link
      Value: Orbit (rviz_default_plugins)
      Yaw: -1.57
      
Window Geometry:
  Height: 800
  Width: 1200
  X: 100
  Y: 100