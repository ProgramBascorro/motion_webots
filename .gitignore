# State lokal Claude Code. worktrees/ berisi checkout penuh repo ini, jadi kalau
# ikut ter-commit isinya jadi salinan repo di dalam repo.
.claude/settings.local.json
.claude/worktrees/

# Runtime Webots yang di-copy ke dalam workspace (pustaka + hasil kompilasi
# controller, ELF aarch64). Ini keluaran build, bukan sumber: aturan *.so/*.o
# sudah menyaring hampir semuanya, sisakan satu berkas `webots-controller` yang
# lolos karena tanpa ekstensi.
/src/webots_ros2/
