<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>yolo_visualizer_node</name>
  <version>0.0.1</version>
  <description>ROS 2 node to visualize YOLO detections on images.</description> <!-- CHANGE THIS -->
  <maintainer email="your@email.com">Your Name</maintainer> <!-- CHANGE THIS -->
  <license>Apache License 2.0</license> <!-- Or your license -->

  <!-- Build tool dependency -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- Execution Dependencies -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>message_filters</exec_depend> <!-- Added for TimeSynchronizer -->
  <!-- python3-opencv is usually pulled in by cv_bridge or installed system-wide -->
  <!-- <exec_depend>python3-opencv</exec_depend> -->


  <!-- Test Dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>