# OP3 serial port -> stable /dev/ttyOP3
#
# Install on the HOST (not in the container):
#   sudo cp scripts/99-op3-opencr.rules /etc/udev/rules.d/99-op3-opencr.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# One port does the work. CHRONUS runs stock opencr_op3, which serves the sub
# controller (ID 200 -- IMU, button, buzzer, DXL power) on DXL_PORT = Serial3,
# i.e. the TTL bus alongside the servos. So ttyOP3 = the U2D2 = servos + ID 200,
# and the OpenCR's micro-USB CDC (/dev/ttyACM0) is only a debug console: it never
# answers a DXL packet, so nothing in the stack addresses it.
#
# A ttyACM must never claim ttyOP3 -- nothing is reachable there.

# U2D2 (FT232H) on the DXL bus -- the 20 servos plus sub controller ID 200
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", SYMLINK+="ttyOP3", MODE="0666"

# OpenCR CDC (/dev/ttyACM0) -- debug console only under stock opencr_op3. Kept
# world-writable for flashing and serial monitoring. A board flashed with
# opencr_op3_usb would serve ID 200 here, and OP3.robot would need this port.
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0666"
