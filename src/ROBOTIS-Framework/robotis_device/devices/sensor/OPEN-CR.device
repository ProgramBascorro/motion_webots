[device info]
model_name  = OPEN-CR
device_type = sensor

# Peta register ini mengikuti firmware "opencr_op3 edited by Fayyadh Raja Gula"
# (dxl_node_op3.h, fw 0x03). Alamat 0..50 sengaja identik dengan firmware bawaan
# ROBOTIS, jadi berkas ini tetap benar untuk board yang masih memakai fw 0x02 --
# hanya blok magnetometer 6..12 dan 51..61 yang kosong/nol di sana.
#
# Beda pokok fw 0x03 terhadap bawaan:
#   - yaw (48) tidak lagi hasil integrasi gyro (yang selalu melayang), melainkan
#     arah kompas magnetometer relatif terhadap arah robot saat OpenCR menyala.
#     Yaw gyro lama tetap ada di yaw_gyro (59) sebagai pembanding.
#   - imu_control (50) mendapat dua bit perintah baru: bit 4 kalibrasi hard-iron,
#     bit 5 nol-kan yaw di arah sekarang.

[control table]
# addr | item name                | length | access | memory |   min value   |  max value  | signed
   0   | model_number             | 2      | R      | EEPROM | 0             | 65535       | N
   2   | version_of_firmware      | 1      | R      | EEPROM | 0             | 254         | N
   3   | ID                       | 1      | RW     | EEPROM | 0             | 252         | N
   4   | baudrate                 | 1      | RW     | EEPROM | 0             | 252         | N
   5   | return_delay_time        | 1      | RW     | EEPROM | 0             | 254         | N
   6   | mag_x_offset             | 2      | RW     | EEPROM | -32768        | 32767       | Y
   8   | mag_y_offset             | 2      | RW     | EEPROM | -32768        | 32767       | Y
   10  | mag_z_offset             | 2      | RW     | EEPROM | -32768        | 32767       | Y
   12  | mag_cali_valid           | 1      | RW     | EEPROM | 0             | 255         | N
   16  | status_return_level      | 1      | RW     | EEPROM | 0             | 2           | N
   24  | dynamixel_power          | 1      | RW     | RAM    | 0             | 1           | N
   25  | LED                      | 1      | RW     | RAM    | 0             | 7           | N
   26  | LED_RGB                  | 2      | RW     | RAM    | 0             | 32767       | N
   28  | buzzer                   | 2      | RW     | RAM    | 0             | 65535       | N
   30  | button                   | 1      | R      | RAM    | 0             | 15          | N
   31  | present_voltage          | 1      | R      | RAM    | 50            | 250         | N
   32  | gyro_x                   | 2      | R      | RAM    | -32800        | 32800       | Y
   34  | gyro_y                   | 2      | R      | RAM    | -32800        | 32800       | Y
   36  | gyro_z                   | 2      | R      | RAM    | -32800        | 32800       | Y
   38  | acc_x                    | 2      | R      | RAM    | -32768        | 32768       | Y
   40  | acc_y                    | 2      | R      | RAM    | -32768        | 32768       | Y
   42  | acc_z                    | 2      | R      | RAM    | -32768        | 32768       | Y
   44  | roll                     | 2      | R      | RAM    | -1800         | 1800        | Y
