# ~/.bashrc for the OP3 container (mounted to /root/.bashrc via docker-compose.yml).
# Makes every interactive shell — including `docker exec -it op3_ros2_humble bash` —
# automatically source ROS 2 and the built workspace, surviving container recreation.

[ -f /opt/ros/humble/setup.bash ]      && source /opt/ros/humble/setup.bash
[ -f /ros2_ws/install/setup.bash ]     && source /ros2_ws/install/setup.bash

export PNPM_HOME=/root/.local/share/pnpm
export PATH="$PNPM_HOME:$PATH"
