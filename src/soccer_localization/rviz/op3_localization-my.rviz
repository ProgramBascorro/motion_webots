                  head_tilt_link:
                    cam_gazebo_link:
                      {}
                    cam_link:
                      {}
                l_hip_yaw_link:
                  l_hip_roll_link:
                    l_hip_pitch_link:
                      l_knee_link:
                        l_ank_pitch_link:
                          l_ank_roll_link:
                            {}
                l_sho_pitch_link:
                  l_sho_roll_link:
                    l_el_link:
                      {}
                r_hip_yaw_link:
                  r_hip_roll_link:
                    r_hip_pitch_link:
                      r_knee_link:
                        r_ank_pitch_link:
                          r_ank_roll_link:
                            {}
                r_sho_pitch_link:
                  r_sho_roll_link:
                    r_el_link:
                      {}
