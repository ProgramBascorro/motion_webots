    </material>
  </xacro:macro>

  <!-- head yaw joint -->
  <xacro:macro name="insert_mesh_head_pan_link">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <geometry>
      <mesh filename="${mesh_prefix}/h1.stl"  scale="0.001 0.001 0.001"/>
