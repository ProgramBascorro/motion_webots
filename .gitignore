# =========================================
# ROS 2 specific ignores (colcon build system)
# =========================================
# Ignore colcon build directories.
# These are the results of compilation and linking and are system-specific.
build/
install/
log/
ros2_logs/

# =========================================
# Standard build and temporary files
# =========================================
# Object files
*.o
*.lo
*.la
*.dlo
*.obj

# Libraries
*.lib
*.a
*.so
*.dylib
*.dll

# Executables (usually generated in build/install, but including for completeness)
# Be cautious with this if you have source files *without* extensions that are
# meant to be tracked.
*.exe
# no extension executables - ignore binaries inside build/install
# This is usually handled by ignoring the directories above, but a fallback:
# /build/*/
# /install/*/
# If you have *source* files without extensions you need to track, remove this.
# *

# Compiled Python files
__pycache__/
*.pyc

# SCons build files
.sconf_temp/

# =========================================
# Editor and IDE temporary files
# =========================================
# Backup files from various editors
*~
#*#

# Swap files
*.swp
*.swo

# Lock files
.#*

# VS Code
.vscode/

# IntelliJ/CLion/PyCharm etc.
.idea/

# Emacs temporary files
\#*#

# Kite AI (autocompletion tool) - can create large indexes
.kite/

# =========================================
# Operating System generated files
# =========================================
# macOS
.DS_Store

# Windows
Thumbs.db

# =========================================
# Miscellaneous
# =========================================
# Files created by patching/merging
*.orig
*.rej

# Local camera/video captures
webcam_*.avi
webcam_*.mkv
webcam_*.mp4
recording_*.mp4
output*.mkv
output*.mp4
tes_infer*.mp4

# Sisa salah ketik perintah shell (berkas kosong bernama seperti flag)
.codex
--net=host

# Dikeluarkan dari repo 2026-08-12, berkasnya sengaja dibiarkan ada di komputer.
# Didaftarkan di sini supaya tidak muncul terus sebagai berkas tak terlacak dan
# tidak gampang ter-`git add -A` kembali.
/IMPLEMENTATION_SUMMARY.md
/INTEGRATION_COMPLETE.md
/NETWORK_ACCESS_SETUP.md
/NETWORK_FIX_APPLIED.md
/CAMERA_RECORDING_GUIDE.md
/RECORDING_QUICKSTART.md
/webcam_record_menu.sh
/quick_record.sh
/record_camera.py
/test_recorder.sh

