          Value: true
        l_hip_yaw_link:
          Value: true
        l_knee_link:
          Value: true
        l_sho_pitch_link:
          Value: true
        l_sho_roll_link:
          Value: true
        map:
          Value: true
        odom:
          Value: true
        r_ank_pitch_link:
          Value: true
        r_ank_roll_link:
          Value: true
        r_el_link:
          Value: true
        r_hip_pitch_link:
          Value: true
        r_hip_roll_link:
          Value: true
        r_hip_yaw_link:
          Value: true
        r_knee_link:
          Value: true
        r_sho_pitch_link:
          Value: true
        r_sho_roll_link:
          Value: true
