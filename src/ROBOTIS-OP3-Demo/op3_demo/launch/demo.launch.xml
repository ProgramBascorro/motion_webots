<?xml version="1.0"?>
<launch>
  <arg name="with_manager" default="true"/>
  <!-- Auxiliaries below are OFF by default: the soccer demo does not need
       face tracking, the browser tuning UI, or the on-the-fly camera tuner
       to run — enabling any of them adds seconds of import/discovery time
       to boot. Opt back in with e.g. with_face:=true. -->
  <arg name="with_face" default="false"/>
  <arg name="with_web_setting" default="false"/>
  <arg name="with_camera_setting" default="false"/>

  <!-- robotis op3 manager -->
  <include if="$(var with_manager)" file="$(find-pkg-share op3_manager)/launch/op3_manager.launch.py"/>

  <!-- Camera + YOLO ball detector (drop-in for the Hough-circle node:
       publishes the same /ball_detector_node/circle_set that BallTracker
       subscribes to). -->
  <include file="$(find-pkg-share op3_ball_detector)/launch/yolo_ball_detector_openvino.launch.py"/>

  <!-- External head tracker. Owns head_pan/head_tilt while the soccer
       demo owns walking + kicking. Uses ABSOLUTE set_joint_states for
       scan poses (so a new target instantly replaces the running
       trajectory, unlike head_control_module's chained scan pattern)
       and tuned forward+down scan positions (no ceiling-facing poses).
       auto_start=false so it stays paused until SoccerDemo publishes
       "start" on /ball_tracker/command via the START button. -->
  <node pkg="op3_ball_localization" exec="head_tracking_node" output="screen">
    <param from="$(find-pkg-share op3_ball_localization)/config/head_tracking.yaml"/>
    <param name="auto_start" value="false"/>
  </node>

  <!-- face tracking — opt-in with with_face:=true -->
  <group if="$(var with_face)">
    <include file="$(find-pkg-share op3_demo)/launch/face_detection_op3.launch.xml"/>
  </group>

  <!-- camera tuning tool — opt-in with with_camera_setting:=true -->
  <group if="$(var with_camera_setting)">
    <include file="$(find-pkg-share op3_camera_setting_tool)/launch/op3_camera_setting_tool.launch.xml"/>
  </group>

  <!-- web setting UI — opt-in with with_web_setting:=true -->
  <group if="$(var with_web_setting)">
    <include file="$(find-pkg-share op3_web_setting_tool)/launch/web_setting_server.launch.xml"/>
  </group>

  <!-- robotis op3 demo. use_head_control:=false hands the head off to the
       external head_tracking_node above; SoccerDemo still owns the FSM,
       walking module switching, ball following, and kicking. -->
  <!-- Tinggi kamera dari LANTAI, meter. Bukan konstanta robot: dipakai untuk
       menghitung jarak bola dari sudut tunduk kepala DAN untuk menghitung
       ambang radius bola, jadi harus mengikuti di mana robot berada.
         berdiri di lantai   : 0.56
         digantung di dudukan: 0.56 + tinggi gantungan
                               gantungan 29,5 cm  ->  0.855  (BAWAAN SEKARANG)
       Bawaannya sengaja 0.855, bukan 0.56, karena robot ini sehari-hari diuji
       dalam keadaan DIGANTUNG dan angka itu yang terbukti benar di lapangan
       (14 tendangan berhasil, log 2026-08-27). Begitu robot turun berdiri di
       lantai, jalankan dengan kick_camera_height:=0.56; ambang radius ikut
       menyesuaikan sendiri, tidak ada angka lain yang perlu disentuh.
       Salah nilai di sini tidak bikin error, cuma membuat jarak yang dilaporkan
       (dan karena itu pemicu tendangan) meleset sebanding. -->
  <arg name="kick_camera_height" default="0.855"/>

  <!-- Ambang tendangan, meter, dalam JARAK TANAH (bukan jarak lurus ke kamera).
       kick_distance juga jadi jarak BERHENTI robot saat mendekati bola.
       Dibuka di sini supaya bisa ditera langsung di robot tanpa build ulang;
       bandingkan dengan angka "jarak bola" yang dicetak BallFollower 1x/detik. -->
  <arg name="kick_distance" default="0.30"/>
  <!-- Batas jarak untuk jalur pemicu JENDELA PAN: bola harus lebih dekat dari
       ini sebelum sudut servo kepala boleh memicu tendangan. Gunanya cuma
       mencegah robot menendang angin saat bolanya masih jauh di seberang
       lapangan tapi kebetulan lurus di depan kaki.
       Bawaannya 1.00 dan bukan 0.40 karena saat robot digantung, jarak hasil
       hitungan sudut kepala memang membesar (kamera lebih tinggi), sehingga
       dengan 0.40 jalur jendela pan praktis tidak pernah kebuka. Angka longgar
       di sini aman: yang menentukan tetap jendela sudut pan itu sendiri. -->
  <arg name="kick_pan_max_distance" default="1.00"/>

  <!-- Ambang jari-jari bola di gambar, PIKSEL. Pengukur jarak yang paling
       sedikit asumsinya: tidak bergantung tanda head_tilt, hip_pitch, ataupun
       apakah kepala menunjuk ke bola. Bola dekat selalu besar di gambar.

       Bawaan 0 berarti DIHITUNG SENDIRI dari kick_distance + kick_camera_height.
       Pakai itu. Ambang radius memang berbeda antara robot berdiri dan robot
       digantung, karena besar bola ditentukan jarak LURUS kamera-ke-bola dan
       itu ikut berubah saat kamera naik. Terukur: bola di lantai tepat di
       posisi kaki = 64,7 px saat digantung 29,5 cm, tapi 101,3 px saat berdiri.
       Angka tetap akan salah di salah satu keadaan.

       Isi angka di sini hanya kalau mau menimpa hasil hitungan; baca
       "radius=NN.Npx" di log detektor YOLO saat bola ada di tempat yang
       diinginkan. Setel angka negatif untuk mematikan jalur ini. -->
  <arg name="kick_ball_radius_px" default="0.0"/>

  <!-- Jendela sudut SERVO head_pan (0..360, tengah 180) yang dianggap "bola ada
       di depan kaki ini". Nilai bawaan berpusat pada angka yang diukur operator
       (157 kanan, 183 kiri), dilebarkan +-4 derajat karena kepala bergerak
       dalam lompatan, bukan sapuan mulus.
       Angka nominal itu ternyata meleset. Yang dipasang di bawah adalah angka
       dari robot, bukan dari perkiraan:

         KIRI  193..208, terukur 2026-08-26 dengan bola benar-benar di sisi
               kiri; servo paling sering duduk di 200, tidak pernah 179..187.
         KANAN 152..167, cerminan jendela kiri terhadap tengah 180 (kiri itu
               +13..+28, jadi kanan -28..-13). Dicocokkan dengan log
               2026-08-27: tendangan kaki kanan terjadi pada servo 156,7 /
               160,0 / 162,3 / 163,5 / 165,2 / 166,1; semuanya masuk 152..167,
               sedangkan jendela lama 153..161 cuma menampung satu.

       Jendela ini SUDUT MENDATAR, jadi tidak berubah saat robot diturunkan dari
       gantungan: yang menentukan letak bola ke samping, bukan tinggi kamera.
       Kalau salah satu kaki tidak pernah terpicu lewat jalur jendela pan, di
       sinilah tempat menyetelnya: baca "servo head_pan NNN deg" di baris
       TENDANG pada log. -->
  <!-- type="float" pada tiap param di bawah BUKAN hiasan: tanpa itu, mengetik
       kick_pan_left_min_deg:=193 (tanpa titik desimal) membuat ROS menyimpulkan
       tipe integer, tidak cocok dengan deklarasi double di kode, dan
       declare_parameter melempar exception yang mematikan op_demo_node
       seketika (exit -6). Dengan type="float", "193" ikut dikonversi.
       Pengenal tipenya "float", BUKAN "double": launch XML ROS 2 menolak
       "double" dengan ValueError: Got invalid type identifier. -->
  <arg name="kick_pan_right_min_deg" default="152.0"/>
  <arg name="kick_pan_right_max_deg" default="167.0"/>
  <arg name="kick_pan_left_min_deg" default="193.0"/>
  <arg name="kick_pan_left_max_deg" default="208.0"/>

  <!-- Bahan hitungan ambang radius otomatis. Rumusnya:
         fokus  = (lebar_gambar / 2) / tan(setengah_FOV)
         miring = akar(kick_distance^2 + (tinggi_kamera - jari_jari_bola)^2)
         ambang = fokus * jari_jari_bola / miring
       Jadi ketiga angka ini cuma perlu disentuh kalau bolanya bukan ukuran 5,
       atau kameranya diganti dengan resolusi / lensa lain. kick_fov_width_deg
       adalah SETENGAH bukaan mendatar, sama persis dengan BallTracker::FOV_WIDTH,
       dan kick_image_width_px harus sama dengan lebar gambar di
       camera_param.yaml, bukan lebar gambar hasil resize di detektor. -->
  <arg name="kick_ball_real_radius_m" default="0.11"/>
  <arg name="kick_fov_width_deg" default="35.2"/>
  <arg name="kick_image_width_px" default="640.0"/>

  <node pkg="op3_demo" exec="op_demo_node" output="screen">
    <param name="kick_camera_height" value="$(var kick_camera_height)" type="float"/>
    <param name="kick_distance" value="$(var kick_distance)" type="float"/>
    <param name="kick_pan_max_distance" value="$(var kick_pan_max_distance)" type="float"/>
    <param name="kick_ball_radius_px" value="$(var kick_ball_radius_px)" type="float"/>
    <param name="kick_pan_right_min_deg" value="$(var kick_pan_right_min_deg)" type="float"/>
    <param name="kick_pan_right_max_deg" value="$(var kick_pan_right_max_deg)" type="float"/>
    <param name="kick_pan_left_min_deg" value="$(var kick_pan_left_min_deg)" type="float"/>
    <param name="kick_pan_left_max_deg" value="$(var kick_pan_left_max_deg)" type="float"/>
    <param name="kick_ball_real_radius_m" value="$(var kick_ball_real_radius_m)" type="float"/>
    <param name="kick_fov_width_deg" value="$(var kick_fov_width_deg)" type="float"/>
    <param name="kick_image_width_px" value="$(var kick_image_width_px)" type="float"/>
    <param name="grass_demo" value="False"/>
    <param name="p_gain" value="0.45"/>
    <param name="d_gain" value="0.045"/>
    <param name="use_head_control" value="false"/>
  </node>
</launch>
