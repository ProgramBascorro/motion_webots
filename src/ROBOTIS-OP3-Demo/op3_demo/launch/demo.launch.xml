<?xml version="1.0"?>
<launch>
  <arg name="with_manager" default="true"/>
  <!-- Auxiliaries below are OFF by default: the soccer demo does not need
       face tracking, the browser tuning UI, or the on-the-fly camera tuner
       to run — enabling any of them adds seconds of import/discovery time
       to boot. Opt back in with e.g. with_face:=true. -->
  <arg name="with_face" default="false"/>
  <arg name="with_web_setting" default="false"/>
  <arg name="with_camera_setting" default="false"/>

  <!-- robotis op3 manager -->
  <include if="$(var with_manager)" file="$(find-pkg-share op3_manager)/launch/op3_manager.launch.py"/>

  <!-- Camera + YOLO ball detector (drop-in for the Hough-circle node:
       publishes the same /ball_detector_node/circle_set that BallTracker
       subscribes to). -->
  <include file="$(find-pkg-share op3_ball_detector)/launch/yolo_ball_detector_openvino.launch.py"/>

  <!-- External head tracker. Owns head_pan/head_tilt while the soccer
       demo owns walking + kicking. Uses ABSOLUTE set_joint_states for
       scan poses (so a new target instantly replaces the running
       trajectory, unlike head_control_module's chained scan pattern)
       and tuned forward+down scan positions (no ceiling-facing poses).
       auto_start=false so it stays paused until SoccerDemo publishes
       "start" on /ball_tracker/command via the START button. -->
  <node pkg="op3_ball_localization" exec="head_tracking_node" output="screen">
    <param from="$(find-pkg-share op3_ball_localization)/config/head_tracking.yaml"/>
    <param name="auto_start" value="false"/>
  </node>

  <!-- face tracking — opt-in with with_face:=true -->
  <group if="$(var with_face)">
    <include file="$(find-pkg-share op3_demo)/launch/face_detection_op3.launch.xml"/>
  </group>

  <!-- camera tuning tool — opt-in with with_camera_setting:=true -->
  <group if="$(var with_camera_setting)">
    <include file="$(find-pkg-share op3_camera_setting_tool)/launch/op3_camera_setting_tool.launch.xml"/>
  </group>

  <!-- web setting UI — opt-in with with_web_setting:=true -->
  <group if="$(var with_web_setting)">
    <include file="$(find-pkg-share op3_web_setting_tool)/launch/web_setting_server.launch.xml"/>
  </group>

  <!-- robotis op3 demo. use_head_control:=false hands the head off to the
       external head_tracking_node above; SoccerDemo still owns the FSM,
       walking module switching, ball following, and kicking. -->
  <!-- Tinggi kamera dari LANTAI, meter. Bukan konstanta robot: dipakai untuk
       menghitung jarak bola dari sudut tunduk kepala, jadi harus mengikuti di
       mana robot berada.
         berdiri di lantai   : 0.56  (bawaan)
         digantung di dudukan: 0.56 + tinggi gantungan
                               contoh gantungan 29,5 cm -> 0.855
       Salah nilai di sini tidak bikin error, cuma membuat jarak yang dilaporkan
       (dan karena itu pemicu tendangan) meleset sebanding. -->
  <arg name="kick_camera_height" default="0.56"/>

  <!-- Ambang tendangan, meter, dalam JARAK TANAH (bukan jarak lurus ke kamera).
       kick_distance juga jadi jarak BERHENTI robot saat mendekati bola.
       Dibuka di sini supaya bisa ditera langsung di robot tanpa build ulang;
       bandingkan dengan angka "jarak bola" yang dicetak BallFollower 1x/detik. -->
  <arg name="kick_distance" default="0.30"/>
  <arg name="kick_pan_max_distance" default="0.40"/>

  <!-- Jendela sudut SERVO head_pan (0..360, tengah 180) yang dianggap "bola ada
       di depan kaki ini". Nilai bawaan berpusat pada angka yang diukur operator
       (157 kanan, 183 kiri), dilebarkan +-4 derajat karena kepala bergerak
       dalam lompatan, bukan sapuan mulus.
       Terukur 2026-08-26: saat bola benar-benar di sisi KIRI, servo justru
       duduk di 193..208 (paling sering 200), bukan 179..187. Kalau kaki kiri
       tidak pernah terpicu, itu tempat pertama yang harus disetel. -->
  <arg name="kick_pan_right_min_deg" default="153.0"/>
  <arg name="kick_pan_right_max_deg" default="161.0"/>
  <arg name="kick_pan_left_min_deg" default="179.0"/>
  <arg name="kick_pan_left_max_deg" default="187.0"/>

  <node pkg="op3_demo" exec="op_demo_node" output="screen">
    <param name="kick_camera_height" value="$(var kick_camera_height)"/>
    <param name="kick_distance" value="$(var kick_distance)"/>
    <param name="kick_pan_max_distance" value="$(var kick_pan_max_distance)"/>
    <param name="kick_pan_right_min_deg" value="$(var kick_pan_right_min_deg)"/>
    <param name="kick_pan_right_max_deg" value="$(var kick_pan_right_max_deg)"/>
    <param name="kick_pan_left_min_deg" value="$(var kick_pan_left_min_deg)"/>
    <param name="kick_pan_left_max_deg" value="$(var kick_pan_left_max_deg)"/>
    <param name="grass_demo" value="False"/>
    <param name="p_gain" value="0.45"/>
    <param name="d_gain" value="0.045"/>
    <param name="use_head_control" value="false"/>
  </node>
</launch>
