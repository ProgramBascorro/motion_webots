# OP3 serial port -> stable /dev/ttyOP3
#
# Install on the HOST (not in the container):
#   sudo cp scripts/99-op3-opencr.rules /etc/udev/rules.d/99-op3-opencr.rules
#   sudo udevadm control --reload-rules && sudo udevadm trigger
#
# Two boards can provide the bus, and they are NOT equivalent:
#
#   OpenCR (CDC, /dev/ttyACM*) - sub controller ID 200 answers here, which is the
#     only way to reach the IMU, button, buzzer and DXL power control.
#   U2D2   (FTDI, /dev/ttyUSB*) - wired straight to the DXL bus: servos reply,
#     ID 200 never does.
#
# So the OpenCR must win /dev/ttyOP3 whenever both are plugged in. link_priority
# makes that deterministic instead of last-one-enumerated-wins.

# OpenCR 1.0 (STM32 virtual COM port) - preferred
SUBSYSTEM=="tty", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", SYMLINK+="ttyOP3", OPTIONS+="link_priority=10", MODE="0666"

# U2D2 (FT232H) - fallback, servos only
SUBSYSTEM=="tty", ATTRS{idVendor}=="0403", ATTRS{idProduct}=="6014", SYMLINK+="ttyOP3", MODE="0666"
