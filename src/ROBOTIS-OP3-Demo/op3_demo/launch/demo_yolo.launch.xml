<?xml version="1.0"?>
<launch>
  <arg name="with_manager" default="true"/>

  <!-- robotis op3 manager. boot_init_page:=-1 dengan alasan yang sama seperti di
       demo.launch.xml: berkas ini juga menjalankan op_demo_node, dan demo_node
       memainkan page 2 sendiri. Dua init pose yang balapan menghasilkan ERROR
       "Can not play page 2.(Now playing)" tiap boot. -->
  <include if="$(var with_manager)" file="$(find-pkg-share op3_manager)/launch/op3_manager.launch.py">
    <arg name="boot_init_page" value="-1"/>
  </include>

  <!-- YOLO detector -->
  <include file="$(find-pkg-share op3_yolo_vision)/launch/yolo.launch.py"/>

  <!-- YOLO -> CircleSet bridge: /ball_detector_node/circle_set untuk mode D60 -->
  <node pkg="op3_ball_localization" exec="yolo_to_demo_bridge" output="screen"/>

  <!-- Head tracking: start paused, activated by mode D60 via /ball_tracker/command -->
  <node pkg="op3_ball_localization" exec="head_tracking_node" output="screen">
    <param from="$(find-pkg-share op3_ball_localization)/config/head_tracking.yaml"/>
    <param name="auto_start" value="false"/>
  </node>

  <!-- camera setting tool (logs to file, not terminal — boots faster) -->
  <include file="$(find-pkg-share op3_camera_setting_tool)/launch/op3_camera_setting_tool.launch.xml"/>

  <!-- robotis op3 demo (mode otomatis D60, vision, action) -->
  <node pkg="op3_demo" exec="op_demo_node" output="screen"/>
</launch>
