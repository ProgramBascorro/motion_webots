<?xml version="1.0"?>
<launch>
  <arg name="with_manager" default="true"/>
  <!-- Auxiliaries below are OFF by default: the soccer demo does not need
       face tracking, the browser tuning UI, or the on-the-fly camera tuner
       to run — enabling any of them adds seconds of import/discovery time
       to boot. Opt back in with e.g. with_face:=true. -->
  <arg name="with_face" default="false"/>
  <arg name="with_web_setting" default="false"/>
  <arg name="with_camera_setting" default="false"/>

  <!-- robotis op3 manager -->
  <include if="$(var with_manager)" file="$(find-pkg-share op3_manager)/launch/op3_manager.launch.py"/>

  <!-- Camera + YOLO ball detector (drop-in for the Hough-circle node:
       publishes the same /ball_detector_node/circle_set that BallTracker
       subscribes to). -->
  <include file="$(find-pkg-share op3_ball_detector)/launch/yolo_ball_detector_openvino.launch.py"/>

  <!-- External head tracker. Owns head_pan/head_tilt while the soccer
       demo owns walking + kicking. Uses ABSOLUTE set_joint_states for
       scan poses (so a new target instantly replaces the running
       trajectory, unlike head_control_module's chained scan pattern)
       and tuned forward+down scan positions (no ceiling-facing poses).
       auto_start=false so it stays paused until SoccerDemo publishes
       "start" on /ball_tracker/command via the START button. -->
  <node pkg="op3_ball_localization" exec="head_tracking_node" output="screen">
    <param from="$(find-pkg-share op3_ball_localization)/config/head_tracking.yaml"/>
    <param name="auto_start" value="false"/>
  </node>

  <!-- face tracking — opt-in with with_face:=true -->
  <group if="$(var with_face)">
    <include file="$(find-pkg-share op3_demo)/launch/face_detection_op3.launch.xml"/>
  </group>

  <!-- camera tuning tool — opt-in with with_camera_setting:=true -->
  <group if="$(var with_camera_setting)">
    <include file="$(find-pkg-share op3_camera_setting_tool)/launch/op3_camera_setting_tool.launch.xml"/>
  </group>

  <!-- web setting UI — opt-in with with_web_setting:=true -->
  <group if="$(var with_web_setting)">
    <include file="$(find-pkg-share op3_web_setting_tool)/launch/web_setting_server.launch.xml"/>
  </group>

  <!-- robotis op3 demo. use_head_control:=false hands the head off to the
       external head_tracking_node above; SoccerDemo still owns the FSM,
       walking module switching, ball following, and kicking. -->
  <!-- Tinggi kamera dari LANTAI, meter. Bukan konstanta robot: dipakai untuk
       menghitung jarak bola dari sudut tunduk kepala DAN untuk menghitung
       ambang radius bola, jadi harus mengikuti di mana robot berada.
         berdiri di lantai   : 0.56   (BAWAAN SEKARANG)
         digantung di dudukan: 0.56 + tinggi gantungan
                               gantungan 29,5 cm  jadi  0.855
       Bawaannya dikembalikan ke 0.56 pada 2026-08-28: demo yang sebenarnya
       dijalankan di LANTAI, dan memakai 0.855 di sana membuat robot menendang
       JAUH terlalu cepat. Sebabnya bisa dihitung: 0.855 menghasilkan ambang
       radius 62,1 px, dan 62,1 px saat kamera ada di 0,56 m berarti bola masih
       0,67 m di depan robot, bukan 0,30 m. Di lapangan itu terlihat sebagai
       "menendang padahal bola belum dekat kaki".
       Kalau robot digantung lagi, jalankan dengan kick_camera_height:=0.855.
       Salah nilai di sini tidak bikin error, cuma membuat jarak yang dilaporkan
       (dan karena itu pemicu tendangan) meleset sebanding. -->
  <arg name="kick_camera_height" default="0.56"/>

  <!-- Ambang tendangan, meter, dalam JARAK TANAH (bukan jarak lurus ke kamera).
       kick_distance juga jadi jarak BERHENTI robot saat mendekati bola.
       Dibuka di sini supaya bisa ditera langsung di robot tanpa build ulang;
       bandingkan dengan angka "jarak bola" yang dicetak BallFollower 1x/detik. -->
  <arg name="kick_distance" default="0.30"/>

  <!-- Batas jarak untuk jalur pemicu JENDELA PAN: bola harus lebih dekat dari
       ini sebelum sudut servo kepala boleh memicu tendangan. Gunanya cuma
       mencegah robot menendang angin saat bolanya masih jauh di seberang
       lapangan tapi kebetulan lurus di depan kaki.
       Ini PAGAR KEWARASAN, bukan penentu. Yang menentukan tetap jendela sudut
       pan itu sendiri; angka ini cuma mencegah robot menendang angin saat bola
       masih di seberang lapangan tapi kebetulan lurus di depan kaki.

       Sempat diperketat ke 0.40 pada 2026-08-28 dan itu SALAH: jarak hasil
       hitungan sudut kepala memang sistematis lebih besar dari jarak
       sebenarnya, jadi 0.40 menutup jalur jendela pan sama sekali. Terukur
       pada run yang sama, 65 dari 261 sampel berbunyi "jendela pan cocok tapi
       bola masih jauh" padahal operator melaporkan bola sudah di depan kaki,
       dan robot tidak menendang satu kali pun. 0.70 memberi ruang untuk
       kelebihan-baca itu tanpa kembali selonggar 1.00. -->
  <!-- Sejak 2026-08-29 pagar ini dibandingkan terhadap jarak dari RADIUS
       bola, bukan lagi jarak dari sudut kepala, jadi angkanya kini berarti
       jarak yang sebenarnya. Karena itu turun dari 0,70 ke 0,50: 0,70 dulu
       melawan angka yang over-baca, sedangkan 0,50 di sini benar-benar
       setengah meter.

       Terukur pada tendangan yang berhasil di run op_demo_node_4568: radius
       77,3 px, yaitu 0,46 m sebenarnya, sementara sudut kepala melaporkan
       0,668 m. Nilai 0,50 memberi ruang untuk kejadian seperti itu tanpa
       membuka pintu untuk bola yang benar-benar masih 0,79 m jauhnya. -->
  <arg name="kick_pan_max_distance" default="0.50"/>

  <!-- Ambang jari-jari bola di gambar, PIKSEL. Pengukur jarak yang paling
       sedikit asumsinya: tidak bergantung tanda head_tilt, hip_pitch, ataupun
       apakah kepala menunjuk ke bola. Bola dekat selalu besar di gambar.

       Bawaan 0 berarti DIHITUNG SENDIRI dari kick_distance + kick_camera_height.
       Pakai itu. Ambang radius memang berbeda antara robot berdiri dan robot
       digantung, karena besar bola ditentukan jarak LURUS kamera-ke-bola dan
       itu ikut berubah saat kamera naik. Terukur: bola di lantai tepat di
       posisi kaki = 64,7 px saat digantung 29,5 cm, tapi 101,3 px saat berdiri.
       Angka tetap akan salah di salah satu keadaan.

       Isi angka di sini hanya kalau mau menimpa hasil hitungan; baca
       "radius=NN.Npx" di log detektor YOLO saat bola ada di tempat yang
       diinginkan. Setel angka negatif untuk mematikan jalur ini. -->
  <arg name="kick_ball_radius_px" default="0.0"/>

  <!-- Jendela sudut SERVO head_pan (0..360, tengah 180) yang dianggap "bola ada
       di depan kaki ini". Nilai bawaan berpusat pada angka yang diukur operator
       (157 kanan, 183 kiri), dilebarkan +-4 derajat karena kepala bergerak
       dalam lompatan, bukan sapuan mulus.
       Angka nominal itu ternyata meleset. Yang dipasang di bawah adalah angka
       dari robot, bukan dari perkiraan:

         KIRI  193..208, terukur 2026-08-26 dengan bola benar-benar di sisi
               kiri; servo paling sering duduk di 200, tidak pernah 179..187.
         KANAN 152..178, dari sebaran TERUKUR juga, bukan cerminan. 21 sampel
               (2 run) memberi kanan 156,7..175,4 dan kiri 175,4..202,6.
               Cerminan sebaran kanan terhadap 180 = 184,6..203,3; ujung atasnya
               cocok dengan ujung atas kiri (202,6), jadi pusat 180 memang benar
               dan dugaan "pusatnya bergeser" tidak terbukti. Yang meleset cuma
               batas ATAS jendela kanan: versi 152..167 memotong 169,2 / 170,4 /
               173,4 / 174,0 / 175,4. Batasnya 178 dan bukan pas 175,4 supaya
               ada margin, tapi tetap berhenti sebelum 180 (lurus ke depan).

       Ada zona mati 178..193 yang tidak masuk jendela mana pun. Itu disengaja:
       di situ bola ada di depan TENGAH badan, bukan di depan salah satu kaki.
       Jalur radius bola yang menanganinya.

       Jendela ini SUDUT MENDATAR, jadi tidak berubah saat robot diturunkan dari
       gantungan: yang menentukan letak bola ke samping, bukan tinggi kamera.
       Kalau salah satu kaki tidak pernah terpicu lewat jalur jendela pan, di
       sinilah tempat menyetelnya: baca "servo head_pan NNN deg" di baris
       TENDANG pada log. -->
  <!-- type="float" pada tiap param di bawah BUKAN hiasan: tanpa itu, mengetik
       kick_pan_left_min_deg:=193 (tanpa titik desimal) membuat ROS menyimpulkan
       tipe integer, tidak cocok dengan deklarasi double di kode, dan
       declare_parameter melempar exception yang mematikan op_demo_node
       seketika (exit -6). Dengan type="float", "193" ikut dikonversi.
       Pengenal tipenya "float", BUKAN "double": launch XML ROS 2 menolak
       "double" dengan ValueError: Got invalid type identifier. -->
  <arg name="kick_pan_right_min_deg" default="152.0"/>
  <arg name="kick_pan_right_max_deg" default="178.0"/>
  <arg name="kick_pan_left_min_deg" default="193.0"/>
  <arg name="kick_pan_left_max_deg" default="208.0"/>

  <!-- Bahan hitungan ambang radius otomatis. Rumusnya:
         fokus  = (lebar_gambar / 2) / tan(setengah_FOV)
         miring = akar(kick_distance^2 + (tinggi_kamera - jari_jari_bola)^2)
         ambang = fokus * jari_jari_bola / miring
       Jadi ketiga angka ini cuma perlu disentuh kalau bolanya bukan ukuran 5,
       atau kameranya diganti dengan resolusi / lensa lain. kick_fov_width_deg
       adalah SETENGAH bukaan mendatar, sama persis dengan BallTracker::FOV_WIDTH,
       dan kick_image_width_px harus sama dengan lebar gambar di
       camera_param.yaml, bukan lebar gambar hasil resize di detektor. -->
  <arg name="kick_ball_real_radius_m" default="0.11"/>
  <arg name="kick_fov_width_deg" default="35.2"/>
  <arg name="kick_image_width_px" default="640.0"/>

  <!-- Potongan pada ambang radius hasil hitungan, pecahan 0..1.

       Perlu karena radius TERUKUR sistematis lebih kecil daripada hitungan
       geometri justru saat bola sudah dekat kaki: di posisi itu badan robot
       sendiri menutupi sebagian bola, kotak deteksi YOLO ikut mengecil, dan
       radiusnya membaca rendah.

       Terukur 2026-08-28, 261 sampel, robot berdiri, operator melaporkan bola
       berkali-kali sudah tepat di depan kaki:
         radius >= 92,3 px (ambang ideal 0,30 m)  2 sampel   (1 %)
         radius >= 82 px                          7 sampel   (3 %)
         radius >= 75 px                          28 sampel  (11 %)
       Dengan ambang ideal tanpa potongan, robot TIDAK menendang sama sekali.

       0.10 memberi ambang 83 px. Kalau masih jarang menendang, naikkan ke
       0.15 (78 px) atau 0.20 (74 px). Kalau justru menendang terlalu jauh,
       turunkan ke 0.05 atau 0. -->
  <arg name="kick_ball_radius_margin" default="0.10"/>

  <!-- Tinggi angkat kaki (z_move_amplitude) terkecil, sebagai PECAHAN dari
       foot_height di param.yaml.

       foot_height sekarang jadi BATAS ATAS, bukan nilai tetap sejak langkah
       pertama. Tinggi angkat naik bertahap mengikuti besar gerakan, serasi
       dengan x_move_amplitude yang memang sudah dinaikkan bertahap oleh
       calcFootstep dalam kelipatan UNIT_FB_STEP sampai MAX_FB_STEP. Langkah
       kecil berarti angkat kaki rendah; kaki baru terangkat penuh saat
       langkahnya penuh.

       Sudut putar ikut diperhitungkan, bukan cuma x, supaya fase memutar di
       tempat (x = 0, hanya angle) tetap mengangkat kaki cukup tinggi.

       0.5 berarti berkisar antara setengah foot_height sampai penuh. Setel
       1.0 untuk mengembalikan perilaku lama (selalu penuh). -->
  <!-- 1.0 = tinggi angkat kaki SELALU penuh (foot_height param.yaml), yaitu
       perilaku asli sebelum penskalaan ini ada. Dikembalikan atas permintaan
       operator 2026-08-29: penskalaan bertahap dicoba tiga kali (0,5 lalu
       dihitung sendiri 0,276) dan tetap terasa seperti kaki mendahului badan,
       jadi lebih baik kembali ke yang sudah dikenal.

       Yang dipercepat sebagai gantinya adalah ramp langkah maju di bawah,
       supaya badan menyusul lebih cepat alih-alih kaki ditahan.

       Isi angka di bawah 1.0 untuk menghidupkan lagi penskalaan (0.276
       menyamakan persentasenya dengan x). -->
  <arg name="walk_z_move_min_ratio" default="1.0"/>

  <!-- MENGITARI bola: jadikan bola porosnya saat robot meluruskan badan ke
       arahnya, bukan kaki robot sendiri.

       Tanpa ini robot memutar di poros sendiri, jadi bola bergeser keluar dari
       depan kaki sebesar sudut putarnya; badan memang jadi lurus tapi bolanya
       pindah ke samping. Dengan ini robot bergeser menyamping seiring
       berputar, jadi bola tetap di tempatnya relatif kaki.

       Acuannya sudut leher, BUKAN magnetometer: sumbernya encoder servo dan
       bisa dipercaya, sedangkan magnetometer sudah terbukti tidak sahih saat
       gait berjalan.

       walk_orbit_max_strafe_mm membatasi geseran menyamping per langkah. Kalau
       geseran yang dibutuhkan melebihi batas, sudut putarnya ikut dikecilkan
       dengan pecahan yang sama, supaya robot tetap mengitari bola, hanya lebih
       pelan. Memotong geserannya saja akan membuat robot berputar lebih cepat
       daripada yang bisa diimbangi, dan bola lepas dari poros lagi.

       Hanya berlaku saat robot SUDAH SAMPAI di bola dan tinggal meluruskan
       diri. Selama masih mendekat, memutar di poros sendiri justru benar:
       langkah maju itu sendiri yang membawa bola ke tengah. Mengitari dari
       jarak jauh malah menghambat, dan angkanya jelas: mengitari bola sejauh
       0,60 m dengan batas geser 20 mm cuma memberi 1,9 deg/langkah.

       Setel walk_orbit_enable:=0.0 untuk kembali memutar di poros sendiri. -->
  <!-- Besar kenaikan langkah maju tiap seperempat periode gait, milimeter.

       Ini yang menentukan seberapa cepat x_move_amplitude merambat dari
       langkah terkecil (5,0 mm) ke penuh (18,1 mm):

         0,3 mm (asli ROBOTIS)  ->  8,7 detik
         0,8 mm                 ->  3,3 detik
         1,5 mm (sekarang)      ->  1,7 detik

       Dinaikkan ke 1,5 bersamaan dengan dikembalikannya tinggi angkat kaki ke
       penuh: karena kaki tidak lagi ditahan rendah, badan harus menyusul lebih
       cepat supaya keduanya terlihat berangkat bersama.

       Turunkan kalau robot jadi kurang mantap saat mulai berjalan. -->
  <arg name="walk_x_ramp_step_mm" default="0.3"/>

  <arg name="walk_orbit_enable" default="1.0"/>
  <arg name="walk_orbit_max_strafe_mm" default="35.0"/>

  <!-- Berapa TICK BERTURUT-TURUT syaratnya harus benar sebelum menendang.
       Loop demo 30 Hz, jadi 4 tick kira-kira 0,13 detik.

       Dulu 10 dan itu terlalu menuntut: deteksi bola justru paling terputus
       tepat di saat bola dekat kaki (badan robot menutupinya), padahal di situ
       juga syaratnya baru terpenuhi. Menuntut 10 tick tanpa putus berarti
       menuntut sepertiga detik pelacakan mulus pada momen yang paling sulit.
       Hitungannya juga dinolkan setiap ada satu tick yang gagal. -->
  <arg name="kick_ready_count" default="4.0"/>

  <!-- ===== Menghadap ke yaw acuan dulu, baru menendang =====================

       Begitu bola masuk posisi tendang, robot TIDAK langsung menendang: ia
       memutar badan di tempat sampai yaw-nya kembali ke kick_yaw_target_deg
       (bawaan 0) dalam toleransi kick_yaw_tolerance_deg (bawaan +-5), baru
       menendang.

       "Yaw 0" itu ARAH YANG DIHADAPI ROBOT SAAT OPENCR MENYALA — papan itu
       menolkan acuan headingnya sendiri waktu start, jadi nol-nya ikut ke mana
       pun robot menghadap saat dinyalakan. Praktisnya: hadapkan robot ke gawang
       waktu menyalakannya, lalu fitur ini berarti "hadap gawang dulu, baru
       tendang". Angkanya bisa dibaca di kartu IMU Orientation pada Bascorro
       Studio (badge OK di sebelah Yaw = mag_status 2/3).

       Fitur ini MATI SENDIRI dan robot menendang seperti dulu kalau
       magnetometer tidak siap: mag_status 0 (papan tanpa magnetometer) atau 1
       (belum settle) membuat open_cr_module memaksa yaw = 0, dan angka paksaan
       itu tidak dipercaya. Cek dengan
         ros2 topic echo /robotis/open_cr/mag_status
       Yang dicari 2 atau 3. -->
  <!-- PENYELARASAN YAW, dengan pembagian tugas dua sensor.

       Sempat dimatikan 2026-08-29 karena magnetometer tidak bisa dipakai saat
       robot berjalan: terukur berayun -87, -78, -58, -43, -25, -82 derajat
       dalam hitungan detik padahal robot cuma jalan di tempat, dan akibatnya
       robot berputar menjauh sampai pengaman menghentikannya di 100, 158, dan
       167 derajat.

       Tapi magnetometer TENANG saat robot berhenti: pada run yang sama,
       selama fase mengerem ia cuma bergeser 1,8 lalu 1,7 lalu 1,6 derajat.
       Dan gyro punya sifat kebalikannya: ia mengukur laju putar, bukan arah
       mata angin, jadi tidak terganggu medan magnet motor, tapi tidak tahu
       di mana gawangnya.

       Jadi masing-masing dipakai HANYA di tempat ia bisa dipercaya:

         magnetometer, sekali, saat DIAM  -> berapa derajat harus diputar
         gyro, terus-menerus, saat JALAN  -> sudah berputar berapa derajat

       Urutan lengkapnya: bola di jangkauan, BERHENTI sampai yaw benar-benar
       diam, baca target dari magnetometer sekali, putar sambil menghitung
       gyro, berhenti, cek ulang dengan magnetometer saat diam lagi, ulangi
       kalau masih meleset, lalu menendang.

       Hanyutan gyro tidak sempat menumpuk karena tiap putaran cuma beberapa
       detik dan hitungannya dinolkan tiap kali putaran baru dimulai.

       Matikan lagi dengan kick_yaw_align_enable:=0.0 kalau perlu demo cepat
       tanpa fase memutar. -->
  <arg name="kick_yaw_align_enable" default="1.0"/>
  <arg name="kick_yaw_target_deg" default="0.0"/>
  <arg name="kick_yaw_tolerance_deg" default="5.0"/>

  <!-- Besar putaran per langkah, derajat: sebanding galat (gain), lalu dijepit
       antara min dan max. Angka bawaannya sama dengan MIN_RL_TURN/MAX_RL_TURN
       yang sudah dipakai saat mengejar bola, jadi memutar di tempat tidak lebih
       ganas daripada berbelok sambil berjalan.
       Kalau robot bolak-balik melewati toleransi (oleng kiri-kanan tanpa pernah
       berhenti), turunkan kick_yaw_min_turn_deg atau lebarkan toleransinya —
       satu langkah gait memang tidak bisa lebih halus dari batas bawah ini. -->
  <arg name="kick_yaw_max_turn_deg" default="8.0"/>
  <arg name="kick_yaw_min_turn_deg" default="5.0"/>
  <arg name="kick_yaw_turn_gain" default="0.20"/>

  <!-- Batas waktu memutar. Kalau habis, robot TETAP menendang (dengan WARN di
       log) alih-alih membeku. Bawaannya longgar karena walking_module memakai
       soft_start_time 2000 ms: dua detik pertama amplitudo putar masih naik
       pelan, jadi putaran nyata baru mulai sesudah itu.
       kick_yaw_settle_sec = jeda sesudah putaran berhenti, supaya gait benar-
       benar reda sebelum kaki diserahkan ke action_module.
       kick_yaw_ready_count = berapa tick berturut-turut yaw harus di dalam
       toleransi sebelum dianggap lurus (30 tick = 1 detik). -->
  <arg name="kick_yaw_timeout_sec" default="12.0"/>
  <arg name="kick_yaw_settle_sec" default="0.7"/>
  <arg name="kick_yaw_ready_count" default="3.0"/>

  <!-- Berapa kali putaran boleh diulang kalau cek SESUDAH gait reda ternyata
       masih di luar toleransi.

       Perlu karena yaw yang dibaca sambil berjalan tidak bisa dipercaya:
       terukur 2026-08-28, dalam satu penyelarasan nilainya melompat -26,5 /
       -30,3 / -31,5 / -27,5 / -33,4 / -44,3 / -28,2 / -18,1 hanya dalam selang
       setengah detik. Badan bergoyang saat gait jalan dan magnetometer ikut
       terbawa, jadi "tiga tick berturut di dalam jendela +-5 deg" bisa
       terpenuhi oleh derau semata. Sesudah robot berhenti angkanya baru
       berarti, dan di situlah pemeriksaan sungguhan dilakukan.

       Setel 0 untuk kembali ke perilaku lama (percaya bacaan sambil jalan). -->
  <arg name="kick_yaw_recheck_max" default="3.0"/>

  <!-- Pengaman putaran LIAR, derajat. Kalau galat membesar lebih dari angka
       ini dari titik acuan, putaran dihentikan paksa dan robot tetap
       menendang.

       Terpasang karena terukur 2026-08-28: robot berputar dari galat 18 deg
       sampai 130 deg dan terus menjauh, BAIK saat tanda putaran +1 MAUPUN
       sesudah koreksi otomatis membaliknya jadi -1. Jadi koreksi tanda saja
       tidak cukup jadi pengaman; harus ada batas keras.

       Setel 0 untuk mematikan pengaman ini (tidak disarankan). -->
  <arg name="kick_yaw_runaway_deg" default="45.0"/>

  <!-- Arah putar gyro dan jendela penilaiannya.

       kick_yaw_gyro_sign menyamakan tanda gyro_z dengan tanda yaw. Kalau
       terbalik, hasil integrasi akan berlawanan dengan target dan robot
       mengira dirinya berputar menjauh.

       kick_yaw_gyro_check_sec: sesudah selang ini arah putaran dinilai dari
       hasil integrasi gyro, dan dibalik sekali kalau ternyata berlawanan
       dengan yang diminta. Cukup 1,2 detik karena gyro langsung memberi tahu
       robot sedang berputar ke mana; dengan magnetometer hal yang sama butuh
       3 sampai 5 detik dan hasilnya tetap salah dua kali. -->
  <arg name="kick_yaw_gyro_sign" default="1.0"/>

  <!-- Pengali hasil integrasi gyro.

       Terukur di robot ini gyro UNDER-BACA: satu putaran yang menurut
       magnetometer 32,4 derajat (dua bacaan, keduanya diambil saat robot DIAM,
       jadi sahih) hanya tercatat 18,6 derajat oleh gyro, yaitu selisih 1,74
       kali.

       Bawaannya tetap 1.0 karena satu pengukuran belum cukup jadi dasar, DAN
       karena lingkarnya sudah benar sendiri: cek ulang magnetometer sesudah
       gait reda menangkap sisa galatnya lalu memutar lagi. Pengali yang meleset
       membuat putarannya butuh lebih banyak percobaan, bukan salah arah.

       Tiap tendangan mencetak angka terukurnya di log ("Pengali gyro
       terukur"). Kalau angkanya berulang konsisten di beberapa tendangan,
       pasang di sini. -->
  <arg name="kick_yaw_gyro_scale" default="1.0"/>

  <!-- Pecahan putaran yang BENAR-BENAR terlaksana dibanding yang
       diperintahkan.

       Geseran menyamping saat mengitari dihitung dari sudut yang DIPERINTAHKAN
       (geser = jarak x sudut). Tapi robot tidak melaksanakan seluruhnya:
       terukur di run op_demo_node_1667 ia diperintahkan berputar 61,5 derajat
       total dan benar-benar berputar 32,4 derajat, yaitu 53 persen.

       Tanpa pecahan ini robot menggeser PENUH sambil berputar setengahnya,
       sehingga bola justru terdorong keluar dari tengah: terbaca +1,9 lalu
       +29,2 derajat sepanjang satu putaran.

       Naikkan mendekati 1.0 kalau robot ternyata melaksanakan putaran lebih
       penuh; turunkan kalau bola masih terdorong ke sisi yang sama dengan arah
       geseran. -->
  <arg name="kick_yaw_orbit_ff_scale" default="0.5"/>
  <arg name="kick_yaw_gyro_check_sec" default="1.2"/>

  <!-- MENGITARI bola selama memutar, supaya bola tetap di tengah pandangan.

       Robot yang berputar di porosnya sendiri pasti melempar bola keluar dari
       tengah: bola diam, badan berputar, jadi arah bola relatif badan bergeser
       sebesar sudut putarnya. Supaya tetap di tengah, robot bergeser
       MENYAMPING sambil berputar, yaitu mengitari bola.

       Umpan baliknya sudut leher: kepala terus mengunci bola, jadi head_pan
       adalah arah bola relatif badan. Geseran menyamping sebanding simpangan
       itu, dengan batas atas supaya tidak pernah jadi langkah samping besar.

       Setel gain 0 untuk mematikan (kembali berputar di poros sendiri). -->
  <arg name="kick_yaw_strafe_gain_mm_per_deg" default="1.5"/>

  <!-- Lama MENGEREM sebelum memutar, detik.

       Robot harus benar-benar berhenti di depan bola dulu. Kalau langsung
       memutar sambil masih melangkah maju, kakinya menabrak bola yang tepat
       ada di depannya; terlihat langsung di lapangan 2026-08-28.

       Urutannya sekarang: bola masuk jangkauan, BERHENTI, memutar ke yaw
       target, baru menendang.

       Jeda ini juga yang memisahkan perintah "stop" dan "start" ke
       walking_module. Dulu keduanya dikirim berselang 39 mikrodetik, tiba
       dalam satu siklus kontrol 8 ms yang sama, dan siapa yang menang jadi
       undian; itulah yang membuat gait mati diam-diam saat memutar. Jangan
       setel 0 tanpa alasan kuat. -->
  <arg name="kick_yaw_brake_sec" default="0.8"/>

  <!-- Batas atas waktu mengerem, detik, dan ambang "yaw dianggap diam".

       Lama minimum di atas belum menjamin robot benar-benar berhenti:
       terukur 2026-08-28, selama mengerem 0,8 detik yaw masih bergeser dari
       -20,6 ke -16,2 (4,4 derajat). Kalau putaran dimulai dari angka yang
       masih bergerak, galat awalnya sudah salah sejak detik pertama.

       Sesudah lama minimum terlewat, robot menunggu dua sampel yaw berturut
       (jeda 0,25 detik) yang bedanya di bawah kick_yaw_brake_still_deg.
       kick_yaw_brake_max_sec membatasi penantian itu supaya robot tidak
       menunggu selamanya kalau lantainya bergetar. -->
  <arg name="kick_yaw_brake_max_sec" default="2.5"/>
  <arg name="kick_yaw_brake_still_deg" default="1.5"/>

  <!-- Jeda diam sebelum halaman aksi tendangan dimainkan, detik.

       Gerakan aksi itu lingkar-terbuka: ia memutar sendi menurut jadwal tetap
       tanpa peduli keadaan badan. Kalau badan masih bergoyang sisa gait, robot
       bisa jatuh saat mengangkat satu kaki. Karena itu ada jeda diam dulu.

       2,0 detik adalah angka yang sudah lama dipakai dan terbukti tidak
       menjatuhkan robot, jadi itu yang jadi bawaan. Ini knob untuk mempercepat
       keputusan menendang: turunkan bertahap (1,5 lalu 1,2) sambil memperhatikan
       apakah robot masih mantap saat kaki terangkat. Jangan langsung ke 0.

       Jalur MEMUTAR sudah menjalani fase reda sendiri sesudah menghentikan
       gait (kick_yaw_settle_sec), dan waktu itu DIKURANGKAN dari jeda ini
       supaya tidak dihitung dua kali. Sebelum diperbaiki, jalur memutar makan
       2,7 detik sementara jalur biasa 2,0 detik. -->
  <arg name="kick_pre_delay_sec" default="2.0"/>

  <!-- Arah putaran. +1 berarti angle_move_amplitude POSITIF memperbesar yaw.
       Hubungan itu BELUM pernah diukur di robot ini, dan menebak tanda sudah
       dua kali memakan waktu berjam-jam di paket ini (lihat catatan head_tilt
       di ball_follower.cpp). Karena itu ada kick_yaw_auto_sign: kalau sesudah
       kick_yaw_sign_check_sec galatnya justru MEMBESAR lebih dari
       kick_yaw_sign_margin_deg, tandanya dibalik SEKALI dan dicatat dengan
       ERROR di log. Tandanya diukur SEKALI per run: hasil koreksi itu dipakai
       untuk semua tendangan berikutnya, jadi cuma tendangan pertama yang
       kehilangan waktu. Pasang angka yang tercetak di kick_yaw_turn_sign supaya
       tendangan pertama pun langsung benar, lalu boleh matikan koreksi
       otomatisnya dengan kick_yaw_auto_sign:=0.0.

       Lama putaran (hasil simulasi loop ini): galat 20 derajat selesai ~3 detik,
       45 derajat ~5 detik, 90 derajat ~8 detik. Dua detik pertama habis untuk
       soft_start walking_module. Kalau koreksi yang dibutuhkan besar DAN gait
       robot kurang efektif memutar, batas waktu 12 detik bisa tercapai; robot
       tetap menendang, dengan WARN. -->
  <!-- ARAH PUTARAN, sudah DIUKUR di robot 2026-08-29 (run op_demo_node_2840).

       +1.0 ini hasil ukur, bukan bawaan yang tidak pernah dicek. Tiga
       penyelarasan berturut dalam satu run, semuanya dengan perintah 15
       deg/langkah ke arah negatif (tanda 1 negatif waktu itu), dan yaw justru
       makin menjauh dari target:

         -54,6 jadi -95,4     -112,5 jadi -158,5     -138,9 jadi -150,6

       Perintah negatif membuat yaw makin NEGATIF, padahal target 0 menuntut
       yaw NAIK. Jadi tandanya harus positif. Cocok juga dengan konvensi umum:
       angle_move_amplitude positif memutar ke kiri, dan yaw naik saat memutar
       ke kiri.

       kick_yaw_auto_sign dimatikan (0.0) karena koreksi otomatis sudah DUA
       KALI salah menilai di robot ini: sekali membalik tanda positif yang
       benar, sekali menyatakan tanda negatif yang salah sebagai "terbukti
       benar". Sebabnya soft_start_time walking_module 2000 ms; selama 2 detik
       pertama amplitudo masih merambat naik, jadi jendela penilaian 3 detik
       cuma menyisakan 1 detik putaran sungguhan dan galatnya nyaris tidak
       bergerak. Jendelanya kini 5 detik, tapi otomatisnya tetap mati karena
       angkanya memang sudah terukur di sini.

       ROBOT LAIN (mis. CHRONUS) harus mengukur sendiri: jalankan dengan
       kick_yaw_auto_sign:=1.0, baca angka yang tercetak, pasang di sini, lalu
       matikan lagi otomatisnya. -->
  <arg name="kick_yaw_turn_sign" default="1.0"/>
  <arg name="kick_yaw_auto_sign" default="0.0"/>
  <arg name="kick_yaw_sign_check_sec" default="5.0"/>
  <arg name="kick_yaw_sign_margin_deg" default="6.0"/>

  <!-- Galat awal MINIMUM sebelum koreksi tanda otomatis boleh menilai, derajat.

       Terukur 2026-08-28: bacaan yaw sambil gait jalan berbeda 5 sampai 10
       derajat dari bacaan sesudah robot berhenti. Kalau galat awalnya cuma
       5,8 derajat, derau sebesar itu sendirian sudah bisa membuatnya terlihat
       "membesar 12,9 derajat", dan tandanya dibalik padahal arah putarannya
       sudah benar. Itu persis yang terjadi: tanda -1 yang sudah terukur benar
       dibalik lagi jadi +1 di tengah rangkaian cek-ulang bergalat kecil.

       Di bawah ambang ini penilaian DITUNDA, bukan diputuskan, jadi
       kesempatan menilai tetap ada pada penyelarasan berikutnya yang
       galatnya cukup besar. -->
  <arg name="kick_yaw_sign_min_error_deg" default="20.0"/>

  <!-- Umur maksimum pesan IMU yang masih boleh dipakai, detik. Yaw yang basi
       berarti memutar buta. -->
  <arg name="kick_yaw_max_age_sec" default="1.0"/>

  <!-- Sesudah badan berputar, kaki penendang dihitung ULANG dari sudut leher
       yang sedang mengunci bola: keputusan lama dibuat sebelum berputar, jadi
       bola yang tadi di depan kaki kanan bisa pindah ke depan kaki kiri.
       Hanya berlaku kalau pelacak memang sedang melihat bola. Setel 0.0 untuk
       memakai keputusan lama apa adanya. -->
  <arg name="kick_refresh_foot_after_align" default="1.0"/>

  <!-- Eskalasi saat putaran MACET. Terukur di robot 2026-08-28: galat 39 deg
       memberi perintah 13,7 deg/langkah dan yaw bergerak, tapi galat 12 deg
       memberi 5,0 deg/langkah dan yaw TIDAK bergerak sama sekali. Jadi ada
       ambang torsi minimum, dan justru galat KECIL yang jatuh di bawahnya.

       Kalau selama kick_yaw_stall_sec galat terbaiknya tidak membaik lebih
       dari kick_yaw_stall_margin_deg, batas BAWAH putaran dinaikkan sebesar
       kick_yaw_turn_step_deg (tidak pernah melewati kick_yaw_max_turn_deg).
       Yang dinaikkan batas bawahnya, bukan gain: yang kurang memang cuma
       langkah terkecil.

       Catatan lapangan: kalau robot DIGANTUNG, kakinya tidak menapak dan yaw
       memang tidak akan pernah berubah. Dalam keadaan itu eskalasi akan mentok
       di batas atas dan mencetak peringatan; itu benar, bukan kerusakan. -->
  <arg name="kick_yaw_stall_sec" default="4.0"/>
  <arg name="kick_yaw_stall_margin_deg" default="3.0"/>
  <arg name="kick_yaw_turn_step_deg" default="2.5"/>

  <node pkg="op3_demo" exec="op_demo_node" output="screen">
    <param name="kick_camera_height" value="$(var kick_camera_height)" type="float"/>
    <param name="kick_distance" value="$(var kick_distance)" type="float"/>
    <param name="kick_pan_max_distance" value="$(var kick_pan_max_distance)" type="float"/>
    <param name="kick_ball_radius_px" value="$(var kick_ball_radius_px)" type="float"/>
    <param name="kick_pan_right_min_deg" value="$(var kick_pan_right_min_deg)" type="float"/>
    <param name="kick_pan_right_max_deg" value="$(var kick_pan_right_max_deg)" type="float"/>
    <param name="kick_pan_left_min_deg" value="$(var kick_pan_left_min_deg)" type="float"/>
    <param name="kick_pan_left_max_deg" value="$(var kick_pan_left_max_deg)" type="float"/>
    <param name="kick_ball_real_radius_m" value="$(var kick_ball_real_radius_m)" type="float"/>
    <param name="kick_fov_width_deg" value="$(var kick_fov_width_deg)" type="float"/>
    <param name="kick_image_width_px" value="$(var kick_image_width_px)" type="float"/>
    <param name="kick_ball_radius_margin" value="$(var kick_ball_radius_margin)" type="float"/>
    <param name="walk_z_move_min_ratio" value="$(var walk_z_move_min_ratio)" type="float"/>
    <param name="walk_x_ramp_step_mm" value="$(var walk_x_ramp_step_mm)" type="float"/>
    <param name="walk_orbit_enable" value="$(var walk_orbit_enable)" type="float"/>
    <param name="walk_orbit_max_strafe_mm" value="$(var walk_orbit_max_strafe_mm)" type="float"/>
    <param name="kick_ready_count" value="$(var kick_ready_count)" type="float"/>
    <param name="kick_yaw_align_enable" value="$(var kick_yaw_align_enable)" type="float"/>
    <param name="kick_yaw_target_deg" value="$(var kick_yaw_target_deg)" type="float"/>
    <param name="kick_yaw_tolerance_deg" value="$(var kick_yaw_tolerance_deg)" type="float"/>
    <param name="kick_yaw_max_turn_deg" value="$(var kick_yaw_max_turn_deg)" type="float"/>
    <param name="kick_yaw_min_turn_deg" value="$(var kick_yaw_min_turn_deg)" type="float"/>
    <param name="kick_yaw_turn_gain" value="$(var kick_yaw_turn_gain)" type="float"/>
    <param name="kick_yaw_timeout_sec" value="$(var kick_yaw_timeout_sec)" type="float"/>
    <param name="kick_yaw_settle_sec" value="$(var kick_yaw_settle_sec)" type="float"/>
    <param name="kick_yaw_ready_count" value="$(var kick_yaw_ready_count)" type="float"/>
    <param name="kick_yaw_recheck_max" value="$(var kick_yaw_recheck_max)" type="float"/>
    <param name="kick_yaw_runaway_deg" value="$(var kick_yaw_runaway_deg)" type="float"/>
    <param name="kick_yaw_gyro_sign" value="$(var kick_yaw_gyro_sign)" type="float"/>
    <param name="kick_yaw_gyro_scale" value="$(var kick_yaw_gyro_scale)" type="float"/>
    <param name="kick_yaw_orbit_ff_scale" value="$(var kick_yaw_orbit_ff_scale)" type="float"/>
    <param name="kick_yaw_gyro_check_sec" value="$(var kick_yaw_gyro_check_sec)" type="float"/>
    <param name="kick_yaw_strafe_gain_mm_per_deg" value="$(var kick_yaw_strafe_gain_mm_per_deg)" type="float"/>
    <param name="kick_yaw_brake_sec" value="$(var kick_yaw_brake_sec)" type="float"/>
    <param name="kick_yaw_brake_max_sec" value="$(var kick_yaw_brake_max_sec)" type="float"/>
    <param name="kick_yaw_brake_still_deg" value="$(var kick_yaw_brake_still_deg)" type="float"/>
    <param name="kick_pre_delay_sec" value="$(var kick_pre_delay_sec)" type="float"/>
    <param name="kick_yaw_turn_sign" value="$(var kick_yaw_turn_sign)" type="float"/>
    <param name="kick_yaw_auto_sign" value="$(var kick_yaw_auto_sign)" type="float"/>
    <param name="kick_yaw_sign_check_sec" value="$(var kick_yaw_sign_check_sec)" type="float"/>
    <param name="kick_yaw_sign_margin_deg" value="$(var kick_yaw_sign_margin_deg)" type="float"/>
    <param name="kick_yaw_sign_min_error_deg" value="$(var kick_yaw_sign_min_error_deg)" type="float"/>
    <param name="kick_yaw_max_age_sec" value="$(var kick_yaw_max_age_sec)" type="float"/>
    <param name="kick_refresh_foot_after_align" value="$(var kick_refresh_foot_after_align)" type="float"/>
    <param name="kick_yaw_stall_sec" value="$(var kick_yaw_stall_sec)" type="float"/>
    <param name="kick_yaw_stall_margin_deg" value="$(var kick_yaw_stall_margin_deg)" type="float"/>
    <param name="kick_yaw_turn_step_deg" value="$(var kick_yaw_turn_step_deg)" type="float"/>
    <param name="grass_demo" value="False"/>
    <param name="p_gain" value="0.45"/>
    <param name="d_gain" value="0.045"/>
    <param name="use_head_control" value="false"/>
  </node>
</launch>
